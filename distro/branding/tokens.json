{
  "project": "OS-1",
  "referenceTarget": {
    "os": "macOS Sequoia 15.x",
    "displayProfiles": [
      { "name": "Laptop 1x", "width": 1440, "height": 900, "scale": 1.0 },
      { "name": "Desktop 1080p", "width": 1920, "height": 1080, "scale": 1.0 },
      { "name": "HiDPI 2x", "width": 2880, "height": 1800, "scale": 2.0 }
    ],
    "ipNotice": "100% original OS-1 visual tokens, artwork, and branding. Zero Apple source, icons, fonts, sounds, or wallpapers."
  },
  "typography": {
    "uiSans": "Noto Sans",
    "monospace": "DejaVu Sans Mono",
    "baseSizePt": 10,
    "smallSizePt": 8.5,
    "menuBarSizePt": 9.5,
    "windowTitleSizePt": 10
  },
  "layout": {
    "spacingUnitPx": 4,
    "menuBarHeightPx": 28,
    "dockHeightPx": 58,
    "dockCornerRadiusPx": 18,
    "windowCornerRadiusPx": 10,
    "controlCornerRadiusPx": 6,
    "windowButtonsLeft": ["close", "minimize", "maximize"],
    "windowButtonsRight": []
  },
  "trafficLights": {
    "close": { "fill": "#FF5F57", "stroke": "#E0443E" },
    "minimize": { "fill": "#FEBC2E", "stroke": "#D89E24" },
    "maximize": { "fill": "#28C840", "stroke": "#1AAB29" },
    "inactive": { "fill": "#C7C7CC", "stroke": "#AEAEB2" }
  },
  "themes": {
    "light": {
      "name": "OS1Light",
      "windowBackground": "#F5F5F7",
      "viewBackground": "#FFFFFF",
      "headerBackground": "#ECECEE",
      "textPrimary": "#1D1D1F",
      "textSecondary": "#6E6E73",
      "accent": "#007AFF",
      "accentHover": "#0066D6",
      "border": "#D1D1D6",
      "menuBarGlass": "rgba(245, 245, 247, 0.78)",
      "dockGlass": "rgba(245, 245, 247, 0.68)",
      "wallpaper": "os1-horizon-light.png"
    },
    "dark": {
      "name": "OS1Dark",
      "windowBackground": "#1E1E20",
      "viewBackground": "#262629",
      "headerBackground": "#2C2C30",
      "textPrimary": "#F5F5F7",
      "textSecondary": "#98989D",
      "accent": "#0A84FF",
      "accentHover": "#409CFF",
      "border": "#3A3A3E",
      "menuBarGlass": "rgba(30, 30, 32, 0.76)",
      "dockGlass": "rgba(38, 38, 41, 0.68)",
      "wallpaper": "os1-horizon-dark.png"
    }
  },
  "motion": {
    "microMs": 150,
    "standardMs": 240,
    "workspaceMs": 320,
    "reducedMotionSupported": true
  }
}
