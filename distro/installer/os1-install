#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-only
"""OS-1 System Installer (UEFI / GPT) — Phase 18 Preflight-Complete & Credential-Safe.

Explicit 13-stage installation pipeline:
  1. Argument parsing (rejects plaintext --password in argv)
  2. Environment discovery
  3. User-input validation (username, reserved/existing accounts, stdin/fd password, hostname, tz, locale)
  4. Target-disk validation (whole block device, not root/live/mounted, writable, >= min size)
  5. Source-artifact validation (rootfs + kernel)
  6. Installation plan generation (--plan, --dry-run, --json-plan; never logs password)
  7. Final confirmation (--confirm-erase-disk + optional --confirm-phrase + pre-apply revalidation)
  8. Destructive apply stage (GPT partitioning + FAT32 ESP + ext4 root)
  9. Filesystem population (copy live rootfs + kernel)
 10. Bootloader installation (standalone UEFI GRUB)
 11. User & system configuration (stdin chpasswd, live autologin cleanup, machine-id, SSH keys)
 12. Post-install validation (GPT, ESP, rootfs, fstab UUIDs, EFI files, user, no live autologin)
 13. Cleanup and final report

SAFETY: No destructive command runs before stages 1-7 succeed completely.
"""

from __future__ import annotations

import argparse
import errno
import json
import os
import re
import shutil
import stat
import subprocess
import sys
from pathlib import Path

MIN_DISK_BYTES = 2 * 1024 * 1024 * 1024  # 2 GiB minimum supported target
MAX_PASSWORD_BYTES = 256
EFI_PART_MIB = 256
RESERVED_USERNAMES = frozenset({
    "root",
    "os1",
    "daemon",
    "bin",
    "sys",
    "sync",
    "games",
    "man",
    "lp",
    "mail",
    "news",
    "uucp",
    "proxy",
    "www-data",
    "backup",
    "list",
    "irc",
    "_apt",
    "nobody",
    "nogroup",
    "systemd-network",
    "systemd-resolve",
    "systemd-timesync",
    "messagebus",
    "sddm",
    "polkitd",
    "avahi",
    "colord",
    "rtkit",
    "sshd",
    "admin",
    "administrator",
    "guest",
})
ALLOWED_USER_GROUPS = "sudo,audio,video,netdev,plugdev"
USERNAME_RE = re.compile(r"^[a-z][a-z0-9_-]{0,31}$")
HOSTNAME_RE = re.compile(r"^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$")


def eprint(*args: object) -> None:
    print(*args, file=sys.stderr, flush=True)


def run_checked(cmd: list[str], **kwargs) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, check=True, **kwargs)


def read_password_from_fd(fd: int) -> str:
    """Read raw password bytes from a file descriptor without echoing or logging."""
    chunks: list[bytes] = []
    while True:
        data = os.read(fd, 1024)
        if not data:
            break
        chunks.append(data)
        if sum(len(c) for c in chunks) > MAX_PASSWORD_BYTES + 4:
            raise ValueError(f"Password exceeds maximum supported length ({MAX_PASSWORD_BYTES} bytes).")
    raw = b"".join(chunks)
    # Strip a single trailing newline (standard pipe convention)
    if raw.endswith(b"\n"):
        raw = raw[:-1]
    if b"\x00" in raw:
        raise ValueError("Password must not contain NUL bytes.")
    if b"\r" in raw or b"\n" in raw:
        raise ValueError("Password must not contain carriage return or newline characters.")
    if len(raw) == 0:
        raise ValueError("Password must not be empty.")
    if len(raw) > MAX_PASSWORD_BYTES:
        raise ValueError(f"Password exceeds maximum supported length ({MAX_PASSWORD_BYTES} bytes).")
    try:
        return raw.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise ValueError("Password must be valid UTF-8.") from exc


def get_existing_passwd_users(rootfs_dir: Path) -> set[str]:
    users: set[str] = set()
    passwd_file = rootfs_dir / "etc" / "passwd"
    if passwd_file.is_file():
        for line in passwd_file.read_text(encoding="utf-8", errors="replace").splitlines():
            if line and not line.startswith("#") and ":" in line:
                users.add(line.split(":", 1)[0])
    return users


def validate_username(username: str, existing_users: set[str]) -> None:
    if not USERNAME_RE.match(username):
        raise ValueError(
            f"Invalid Linux username {username!r}: must start with a lowercase letter and contain only [a-z0-9_-] (max 32 chars)."
        )
    if username in RESERVED_USERNAMES:
        raise ValueError(f"Username {username!r} is reserved and cannot be selected.")
    if username in existing_users:
        raise ValueError(f"Username {username!r} already exists in target rootfs /etc/passwd.")


def validate_hostname(hostname: str) -> None:
    if not HOSTNAME_RE.match(hostname):
        raise ValueError(f"Invalid hostname {hostname!r}: must match RFC-1123 label rules.")


def read_mounts() -> list[tuple[str, str]]:
    mounts: list[tuple[str, str]] = []
    try:
        with open("/proc/mounts", encoding="utf-8") as f:
            for line in f:
                parts = line.split()
                if len(parts) >= 2:
                    mounts.append((parts[0], parts[1]))
    except OSError:
        pass
    return mounts


def get_disk_identity(disk_path: str, allow_regular_file: bool = False) -> dict:
    """Inspect target disk safely without modifying it."""
    if not os.path.exists(disk_path):
        raise ValueError(f"Target disk does not exist: {disk_path}")

    real_disk = os.path.realpath(disk_path)
    st = os.stat(real_disk)
    is_block = stat.S_ISBLK(st.st_mode)
    is_reg = stat.S_ISREG(st.st_mode)

    if not is_block and not (allow_regular_file and is_reg):
        raise ValueError(f"Target disk is not a block device: {disk_path}")

    dev_name = os.path.basename(real_disk)
    major = os.major(st.st_rdev) if is_block else 0
    minor = os.minor(st.st_rdev) if is_block else 0
    size_bytes = 0
    readonly = False
    existing_parts: list[str] = []

    if is_block:
        sys_block = Path("/sys/block") / dev_name
        if not sys_block.is_dir():
            raise ValueError(
                f"Target {disk_path} ({real_disk}) is not a whole block device (partitions are not allowed)."
            )
        ro_file = sys_block / "ro"
        if ro_file.is_file() and ro_file.read_text(encoding="utf-8").strip() == "1":
            readonly = True
        size_file = sys_block / "size"
        if size_file.is_file():
            size_bytes = int(size_file.read_text(encoding="utf-8").strip()) * 512
        for entry in sorted(sys_block.iterdir()):
            if entry.is_dir() and (entry / "partition").is_file():
                existing_parts.append(f"/dev/{entry.name}")
    else:
        size_bytes = st.st_size
        readonly = not os.access(real_disk, os.W_OK)

    if readonly:
        raise ValueError(f"Target disk is read-only: {disk_path}")
    if size_bytes <= 0:
        raise ValueError(f"Target disk has zero size: {disk_path}")
    if size_bytes < MIN_DISK_BYTES:
        raise ValueError(
            f"Target disk {disk_path} is too small ({size_bytes // (1024 * 1024)} MiB; minimum is {MIN_DISK_BYTES // (1024 * 1024)} MiB)."
        )

    # Check mounted filesystems, active root, and live medium
    mounts = read_mounts()
    for src, mnt in mounts:
        if not src.startswith("/dev/"):
            continue
        real_src = os.path.realpath(src)
        if real_src == real_disk or real_src in existing_parts or real_src.startswith(real_disk):
            # Ensure prefix match doesn't false-match /dev/sda vs /dev/sda10 vs /dev/sdaa
            suffix = real_src[len(real_disk):]
            if suffix == "" or suffix[0].isdigit() or (suffix.startswith("p") and len(suffix) > 1 and suffix[1].isdigit()):
                if mnt == "/":
                    raise ValueError(f"Refusing to target disk containing active root filesystem: {disk_path}")
                if mnt.startswith("/run/live"):
                    raise ValueError(f"Refusing to target active live-media disk: {disk_path}")
                raise ValueError(f"Target disk {disk_path} has mounted partition {src} at {mnt}.")

    return {
        "disk": disk_path,
        "realpath": real_disk,
        "major": major,
        "minor": minor,
        "size_bytes": size_bytes,
        "size_mib": size_bytes // (1024 * 1024),
        "existing_partitions": existing_parts,
    }


def read_os_release_pretty(rootfs_dir: Path) -> str:
    os_rel = rootfs_dir / "etc" / "os-release"
    if os_rel.is_file():
        for line in os_rel.read_text(encoding="utf-8", errors="replace").splitlines():
            if line.startswith("PRETTY_NAME="):
                return line.split("=", 1)[1].strip().strip('"')
    return "OS-1"


def parse_args(argv: list[str]) -> argparse.Namespace:
    # Explicitly reject plaintext --password or --luks-passphrase in argv
    for arg in argv:
        if arg == "--password" or arg.startswith("--password="):
            eprint("ERROR: --password on the command line is forbidden for credential safety.")
            eprint("Use --password-stdin or --password-fd <N> instead.")
            sys.exit(2)
        if arg == "--luks-passphrase" or arg.startswith("--luks-passphrase="):
            eprint("ERROR: --luks-passphrase on the command line is forbidden for credential safety.")
            eprint("Use --luks-passphrase-stdin or --luks-passphrase-fd <N> instead.")
            sys.exit(2)

    parser = argparse.ArgumentParser(
        prog="os1-install",
        description="OS-1 System Installer (UEFI / GPT) — Nondestructive by default.",
    )
    parser.add_argument("--disk", required=True, help="Target whole block device (e.g. /dev/vda, /dev/nvme0n1)")
    parser.add_argument("--user", required=True, help="First non-root administrator username")
    pw_group = parser.add_mutually_exclusive_group(required=False)
    pw_group.add_argument("--password-stdin", action="store_true", help="Read user password from stdin")
    pw_group.add_argument("--password-fd", type=int, help="Read user password from file descriptor N")
    parser.add_argument("--encrypt", action="store_true", help="Enable LUKS2 full-disk encryption on root partition")
    luks_group = parser.add_mutually_exclusive_group(required=False)
    luks_group.add_argument("--luks-passphrase-stdin", action="store_true", help="Read LUKS2 passphrase from stdin")
    luks_group.add_argument("--luks-passphrase-fd", type=int, help="Read LUKS2 passphrase from file descriptor N")
    parser.add_argument("--hostname", default="os1", help="System hostname (default: os1)")
    parser.add_argument("--timezone", default="UTC", help="IANA timezone (default: UTC)")
    parser.add_argument("--locale", default="en_US.UTF-8", help="System locale (default: en_US.UTF-8)")
    parser.add_argument("--plan", action="store_true", help="Print installation plan and exit without modifying disk")
    parser.add_argument("--dry-run", action="store_true", help="Run all preflight validations and print plan without modifying disk")
    parser.add_argument("--json-plan", action="store_true", help="Emit installation plan as JSON and exit without modifying disk")
    parser.add_argument("--confirm-erase-disk", action="store_true", help="Explicit confirmation to erase and repartition --disk")
    parser.add_argument("--confirm-phrase", default="", help="Optional confirmation phrase matching 'ERASE <disk>'")
    parser.add_argument("--source-ro", default="/run/live/ro", help=argparse.SUPPRESS)
    parser.add_argument("--source-kernel", default="/run/live/medium/boot/vmlinuz", help=argparse.SUPPRESS)
    parser.add_argument("--allow-file-target-for-preflight-test", action="store_true", help=argparse.SUPPRESS)
    return parser.parse_args(argv)


def main(argv: list[str]) -> int:
    # === STAGE 1: Argument parsing ===
    args = parse_args(argv)
    plan_only = args.plan or args.dry_run or args.json_plan

    if args.password_stdin and args.luks_passphrase_stdin:
        eprint("ERROR: Cannot read both --password-stdin and --luks-passphrase-stdin from stdin; use --password-fd or --luks-passphrase-fd.")
        return 2

    if not plan_only and os.geteuid() != 0:
        eprint("ERROR: os1-install must run as root to perform installation.")
        return 1

    # === STAGE 2: Environment discovery ===
    source_ro = Path(args.source_ro)
    source_kernel = Path(args.source_kernel)
    kernel_rel = os.uname().release

    # === STAGE 5 (early read-only check): Source-artifact validation ===
    if not source_ro.is_dir() or not (source_ro / "etc").is_dir():
        eprint(f"ERROR: Live rootfs artifact not found or invalid at {source_ro}.")
        return 1
    if not source_kernel.is_file() or source_kernel.stat().st_size == 0:
        eprint(f"ERROR: Live kernel artifact not found or empty at {source_kernel}.")
        return 1

    # === STAGE 3: User-input validation ===
    existing_users = get_existing_passwd_users(source_ro)
    try:
        validate_username(args.user, existing_users)
        validate_hostname(args.hostname)
    except ValueError as exc:
        eprint(f"ERROR: {exc}")
        return 2

    tz_file = source_ro / "usr" / "share" / "zoneinfo" / args.timezone
    if not tz_file.is_file():
        eprint(f"ERROR: Unknown timezone {args.timezone!r} (not found in target zoneinfo).")
        return 2

    password: str | None = None
    if args.password_stdin:
        try:
            password = read_password_from_fd(sys.stdin.fileno())
        except ValueError as exc:
            eprint(f"ERROR: Invalid password: {exc}")
            return 2
    elif args.password_fd is not None:
        try:
            password = read_password_from_fd(args.password_fd)
        except (ValueError, OSError) as exc:
            eprint(f"ERROR: Failed to read password from fd {args.password_fd}: {exc}")
            return 2
    elif not plan_only:
        eprint("ERROR: Password must be supplied via --password-stdin or --password-fd <N>.")
        return 2

    luks_passphrase: str | None = None
    if args.encrypt:
        if args.luks_passphrase_stdin:
            try:
                luks_passphrase = read_password_from_fd(sys.stdin.fileno())
            except ValueError as exc:
                eprint(f"ERROR: Invalid LUKS passphrase: {exc}")
                return 2
        elif args.luks_passphrase_fd is not None:
            try:
                luks_passphrase = read_password_from_fd(args.luks_passphrase_fd)
            except (ValueError, OSError) as exc:
                eprint(f"ERROR: Failed to read LUKS passphrase from fd {args.luks_passphrase_fd}: {exc}")
                return 2
        elif not plan_only:
            eprint("ERROR: --encrypt requires --luks-passphrase-stdin or --luks-passphrase-fd <N>.")
            return 2
        if luks_passphrase is not None and len(luks_passphrase) < 8:
            eprint("ERROR: LUKS2 encryption passphrase must be at least 8 characters.")
            return 2

    # === STAGE 4: Target-disk validation ===
    try:
        disk_info = get_disk_identity(
            args.disk,
            allow_regular_file=(plan_only and args.allow_file_target_for_preflight_test),
        )
    except ValueError as exc:
        eprint(f"ERROR: {exc}")
        return 1

    boot_part_mib = 512 if args.encrypt else 0
    root_size_mib = disk_info["size_mib"] - EFI_PART_MIB - boot_part_mib - 1
    os_pretty = read_os_release_pretty(source_ro)

    # === STAGE 6: Installation plan generation (NEVER includes password or passphrase) ===
    plan = {
        "target_disk": disk_info["disk"],
        "target_realpath": disk_info["realpath"],
        "target_size_mib": disk_info["size_mib"],
        "existing_partitions": disk_info["existing_partitions"],
        "partition_table": "gpt",
        "efi_partition_mib": EFI_PART_MIB,
        "efi_filesystem": "vfat",
        "boot_partition_mib": boot_part_mib,
        "boot_filesystem": "ext4" if args.encrypt else None,
        "root_partition_mib": root_size_mib,
        "root_filesystem": "ext4",
        "encryption_enabled": bool(args.encrypt),
        "encryption_type": "luks2" if args.encrypt else None,
        "hostname": args.hostname,
        "username": args.user,
        "user_groups": ALLOWED_USER_GROUPS.split(","),
        "timezone": args.timezone,
        "locale": args.locale,
        "kernel_version": kernel_rel,
        "bootloader_destination": "/boot/efi/EFI/BOOT/BOOTX64.EFI",
        "source_rootfs": str(source_ro),
        "source_kernel": str(source_kernel),
        "os_version": os_pretty,
        "erase_warning": f"ALL EXISTING DATA ON {disk_info['disk']} WILL BE ERASED",
    }

    if args.json_plan:
        print(json.dumps(plan, indent=2))
        return 0

    print("================================================================")
    print(" OS-1 UEFI Installation Plan")
    print("================================================================")
    print(f"  OS Version:   {plan['os_version']}")
    print(f"  Target Disk:  {plan['target_disk']} ({plan['target_size_mib']} MiB) — ALL EXISTING DATA WILL BE ERASED")
    print(f"  Existing:     {', '.join(plan['existing_partitions']) or 'none'}")
    if args.encrypt:
        print(f"  Layout:       GPT -> p1: {EFI_PART_MIB} MiB FAT32 ESP + p2: {boot_part_mib} MiB ext4 /boot + p3: ~{root_size_mib} MiB LUKS2 ext4 root")
    else:
        print(f"  Layout:       GPT -> p1: {EFI_PART_MIB} MiB FAT32 ESP + p2: ~{root_size_mib} MiB ext4 root")
    print(f"  Encryption:   {'LUKS2 enabled' if plan['encryption_enabled'] else 'disabled'}")
    print(f"  Hostname:     {plan['hostname']}")
    print(f"  Admin User:   {plan['username']} ({ALLOWED_USER_GROUPS})")
    print(f"  Timezone:     {plan['timezone']}")
    print(f"  Locale:       {plan['locale']}")
    print(f"  Kernel:       {plan['kernel_version']}")
    print(f"  Bootloader:   {plan['bootloader_destination']}")
    print(f"  Source:       {plan['source_rootfs']} + {plan['source_kernel']}")
    print("================================================================", flush=True)

    if plan_only:
        print("[os1-install] Dry-run/plan mode complete. No disk modifications were made.")
        return 0

    # === STAGE 7: Final confirmation & pre-apply revalidation ===
    if not args.confirm_erase_disk:
        eprint("WARNING: NONDESTRUCTIVE DEFAULT MODE.")
        eprint(f"Refusing to erase {args.disk} without explicit --confirm-erase-disk flag.")
        return 3

    if args.confirm_phrase and args.confirm_phrase != f"ERASE {args.disk}":
        eprint(f"ERROR: Confirmation phrase mismatch (expected 'ERASE {args.disk}').")
        return 3

    # Revalidate target device identity immediately before partitioning
    try:
        disk_info_now = get_disk_identity(args.disk, allow_regular_file=False)
    except ValueError as exc:
        eprint(f"ERROR: Pre-apply revalidation failed: {exc}")
        return 1

    if (
        disk_info_now["realpath"] != disk_info["realpath"]
        or disk_info_now["major"] != disk_info["major"]
        or disk_info_now["minor"] != disk_info["minor"]
        or disk_info_now["size_bytes"] != disk_info["size_bytes"]
    ):
        eprint("ERROR: Target disk identity changed between planning and apply. Aborting.")
        return 1

    assert password is not None
    if args.encrypt:
        assert luks_passphrase is not None

    disk = disk_info["realpath"]
    if disk[-1].isdigit():
        efi_part = f"{disk}p1"
        boot_part = f"{disk}p2" if args.encrypt else None
        root_part = f"{disk}p3" if args.encrypt else f"{disk}p2"
    else:
        efi_part = f"{disk}1"
        boot_part = f"{disk}2" if args.encrypt else None
        root_part = f"{disk}3" if args.encrypt else f"{disk}2"

    target = Path("/mnt/os1-target")
    luks_mapper = "os1_crypt"
    luks_opened = False

    def cleanup_mounts() -> None:
        nonlocal luks_opened
        subprocess.run(["umount", "-R", str(target)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if luks_opened:
            subprocess.run(["cryptsetup", "close", luks_mapper], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            luks_opened = False

    try:
        # === STAGE 8: Destructive apply stage ===
        if args.encrypt:
            print(f"[os1-install] Partitioning {disk} with GPT (ESP + /boot + LUKS2 root)...", flush=True)
            boot_end_mib = EFI_PART_MIB + 1 + boot_part_mib
            run_checked(["parted", "-s", disk, "mklabel", "gpt"])
            run_checked(["parted", "-s", disk, "mkpart", "ESP", "fat32", "1MiB", f"{EFI_PART_MIB + 1}MiB"])
            run_checked(["parted", "-s", disk, "set", "1", "esp", "on"])
            run_checked(["parted", "-s", disk, "mkpart", "OS1_BOOT", "ext4", f"{EFI_PART_MIB + 1}MiB", f"{boot_end_mib}MiB"])
            run_checked(["parted", "-s", disk, "mkpart", "OS1_LUKS", f"{boot_end_mib}MiB", "100%"])
        else:
            print(f"[os1-install] Partitioning {disk} with GPT (ESP + ext4 root)...", flush=True)
            run_checked(["parted", "-s", disk, "mklabel", "gpt"])
            run_checked(["parted", "-s", disk, "mkpart", "ESP", "fat32", "1MiB", f"{EFI_PART_MIB + 1}MiB"])
            run_checked(["parted", "-s", disk, "set", "1", "esp", "on"])
            run_checked(["parted", "-s", disk, "mkpart", "OS1_ROOT", "ext4", f"{EFI_PART_MIB + 1}MiB", "100%"])

        import time
        expected_parts = [p for p in (efi_part, boot_part, root_part) if p is not None]
        subprocess.run(["udevadm", "settle", "--timeout=15"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        for attempt in range(20):
            if all(os.path.exists(p) for p in expected_parts):
                break
            if attempt in (0, 5, 10):
                subprocess.run(["partprobe", disk], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                subprocess.run(["blockdev", "--rereadpt", disk], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                subprocess.run(["udevadm", "settle", "--timeout=5"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            time.sleep(1)

        if not all(os.path.exists(p) for p in expected_parts):
            eprint(f"ERROR: Partition nodes {expected_parts} did not appear.")
            return 1

        print(f"[os1-install] Formatting {efi_part} (FAT32)...", flush=True)
        run_checked(["mkfs.fat", "-F", "32", "-n", "OS1_EFI", efi_part], stdout=subprocess.DEVNULL)

        boot_uuid = ""
        luks_uuid = ""
        root_block_dev = root_part

        if args.encrypt:
            assert boot_part is not None and luks_passphrase is not None
            print(f"[os1-install] Formatting {boot_part} (ext4 /boot) and initializing LUKS2 on {root_part}...", flush=True)
            run_checked(
                ["mkfs.ext4", "-F", "-O", "^orphan_file,^metadata_csum_seed", "-L", "OS1_BOOT", boot_part],
                stdout=subprocess.DEVNULL,
            )
            luks_key_bytes = luks_passphrase.encode("utf-8")
            try:
                run_checked(
                    [
                        "cryptsetup",
                        "luksFormat",
                        "--type",
                        "luks2",
                        "--batch-mode",
                        "--pbkdf",
                        "pbkdf2",
                        "--key-file",
                        "-",
                        root_part,
                    ],
                    input=luks_key_bytes,
                )
                run_checked(
                    [
                        "cryptsetup",
                        "open",
                        "--type",
                        "luks2",
                        "--key-file",
                        "-",
                        root_part,
                        luks_mapper,
                    ],
                    input=luks_key_bytes,
                )
                luks_opened = True
            finally:
                luks_passphrase = ""
                luks_key_bytes = b""

            luks_uuid = subprocess.check_output(["cryptsetup", "luksUUID", root_part], text=True).strip()
            boot_uuid = subprocess.check_output(["blkid", "-s", "UUID", "-o", "value", boot_part], text=True).strip()
            root_block_dev = f"/dev/mapper/{luks_mapper}"
            print(f"[os1-install] Formatting unlocked {root_block_dev} (ext4)...", flush=True)
            run_checked(
                ["mkfs.ext4", "-F", "-O", "^orphan_file,^metadata_csum_seed", "-L", "OS1_ROOT", root_block_dev],
                stdout=subprocess.DEVNULL,
            )
        else:
            print(f"[os1-install] Formatting {root_part} (ext4)...", flush=True)
            run_checked(
                ["mkfs.ext4", "-F", "-O", "^orphan_file,^metadata_csum_seed", "-L", "OS1_ROOT", root_part],
                stdout=subprocess.DEVNULL,
            )

        efi_uuid = subprocess.check_output(["blkid", "-s", "UUID", "-o", "value", efi_part], text=True).strip()
        root_uuid = subprocess.check_output(["blkid", "-s", "UUID", "-o", "value", root_block_dev], text=True).strip()
        root_partuuid = subprocess.check_output(["blkid", "-s", "PARTUUID", "-o", "value", root_part], text=True).strip()

        # === STAGE 9: Filesystem population ===
        print(f"[os1-install] Mounting target partitions at {target}...", flush=True)
        target.mkdir(parents=True, exist_ok=True)
        run_checked(["mount", root_block_dev, str(target)])
        if args.encrypt:
            assert boot_part is not None
            (target / "boot").mkdir(parents=True, exist_ok=True)
            run_checked(["mount", boot_part, str(target / "boot")])
        (target / "boot" / "efi").mkdir(parents=True, exist_ok=True)
        run_checked(["mount", efi_part, str(target / "boot" / "efi")])

        print(f"[os1-install] Copying clean OS-1 rootfs from {source_ro}...", flush=True)
        run_checked(["cp", "-a", f"{source_ro}/.", f"{target}/"])

        print(f"[os1-install] Installing OS-1 kernel ({kernel_rel}) to /boot and ESP...", flush=True)
        efi_os1_dir = target / "boot" / "efi" / "EFI" / "os1"
        efi_os1_dir.mkdir(parents=True, exist_ok=True)
        vmlinuz_versioned = f"vmlinuz-{kernel_rel}"
        shutil.copyfile(source_kernel, target / "boot" / vmlinuz_versioned)
        shutil.copyfile(source_kernel, target / "boot" / "vmlinuz-os1")
        shutil.copyfile(source_kernel, efi_os1_dir / vmlinuz_versioned)
        shutil.copyfile(source_kernel, efi_os1_dir / "vmlinuz-os1")

        # === STAGE 11 (host-side system identity & live cleanup) ===
        # Remove live-mode marker
        live_marker = target / "etc" / "os1-live-mode"
        if live_marker.exists():
            live_marker.unlink()

        # Remove live SDDM autologin so installed system never targets deleted live user
        sddm_conf = target / "etc" / "sddm.conf.d" / "10-os1-wayland.conf"
        if sddm_conf.is_file():
            cleaned_lines: list[str] = []
            in_autologin = False
            for line in sddm_conf.read_text(encoding="utf-8").splitlines():
                stripped = line.strip()
                if stripped.startswith("[") and stripped.endswith("]"):
                    in_autologin = stripped.lower() == "[autologin]"
                if not in_autologin:
                    cleaned_lines.append(line)
            sddm_conf.write_text("\n".join(cleaned_lines).rstrip() + "\n", encoding="utf-8")

        # Write real /etc/fstab (and /etc/crypttab when LUKS2 is enabled)
        if args.encrypt:
            (target / "etc" / "crypttab").write_text(
                f"{luks_mapper} UUID={luks_uuid} none luks,discard\n",
                encoding="utf-8",
            )
            (target / "etc" / "fstab").write_text(
                f"/dev/mapper/{luks_mapper}  /          ext4  defaults,noatime,errors=remount-ro  0  1\n"
                f"UUID={boot_uuid}   /boot      ext4  defaults,noatime                    0  2\n"
                f"UUID={efi_uuid}    /boot/efi  vfat  umask=0077                          0  2\n",
                encoding="utf-8",
            )
        else:
            (target / "etc" / "fstab").write_text(
                f"UUID={root_uuid}  /          ext4  defaults,noatime,errors=remount-ro  0  1\n"
                f"UUID={efi_uuid}   /boot/efi  vfat  umask=0077                          0  2\n",
                encoding="utf-8",
            )

        # Hostname & hosts
        (target / "etc" / "hostname").write_text(f"{args.hostname}\n", encoding="utf-8")
        (target / "etc" / "hosts").write_text(
            f"127.0.0.1\tlocalhost\n127.0.1.1\t{args.hostname}\n::1\t\tlocalhost ip6-localhost ip6-loopback\n",
            encoding="utf-8",
        )

        # Timezone & locale
        localtime_link = target / "etc" / "localtime"
        if localtime_link.exists() or localtime_link.is_symlink():
            localtime_link.unlink()
        os.symlink(f"/usr/share/zoneinfo/{args.timezone}", localtime_link)
        (target / "etc" / "timezone").write_text(f"{args.timezone}\n", encoding="utf-8")

        locale_gen = target / "etc" / "locale.gen"
        if locale_gen.is_file():
            lg_text = locale_gen.read_text(encoding="utf-8", errors="replace")
            lg_text = re.sub(rf"^#\s*{re.escape(args.locale)}", args.locale, lg_text, flags=re.MULTILINE)
            locale_gen.write_text(lg_text, encoding="utf-8")
        (target / "etc" / "default" / "locale").write_text(f"LANG={args.locale}\n", encoding="utf-8")

        # Regenerate machine-id on first boot / setup
        machine_id = target / "etc" / "machine-id"
        machine_id.write_text("", encoding="utf-8")

        # Mount virtual filesystems for chroot configuration
        for vfs in ("dev", "proc", "sys"):
            run_checked(["mount", "--bind", f"/{vfs}", str(target / vfs)])

        chroot_env = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "DEBIAN_FRONTEND": "noninteractive"}

        run_checked(["chroot", str(target), "locale-gen"], env=chroot_env)
        run_checked(["chroot", str(target), "systemd-machine-id-setup"], env=chroot_env)

        # Create requested non-root admin user without any shell interpolation
        run_checked(
            ["chroot", str(target), "useradd", "-m", "-s", "/bin/bash", "-G", ALLOWED_USER_GROUPS, args.user],
            env=chroot_env,
        )

        # Pass credentials strictly via protected stdin pipe to chpasswd
        cred_payload = f"{args.user}:{password}\n".encode("utf-8")
        try:
            run_checked(["chroot", str(target), "chpasswd"], input=cred_payload, env=chroot_env)
        finally:
            password = ""
            cred_payload = b""

        # Ensure home directory ownership
        run_checked(["chroot", str(target), "chown", "-R", f"{args.user}:{args.user}", f"/home/{args.user}"], env=chroot_env)

        # Remove live user 'os1' and live-only credentials
        if subprocess.run(["chroot", str(target), "id", "-u", "os1"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=chroot_env).returncode == 0:
            subprocess.run(["chroot", str(target), "userdel", "-r", "os1"], env=chroot_env, check=False)

        # Regenerate SSH host keys if OpenSSH server is installed
        if (target / "etc" / "ssh" / "sshd_config").is_file():
            for key_file in (target / "etc" / "ssh").glob("ssh_host_*"):
                key_file.unlink(missing_ok=True)
            subprocess.run(["chroot", str(target), "ssh-keygen", "-A"], env=chroot_env, check=False)

        # === STAGE 10: Bootloader installation ===
        print("[os1-install] Installing standalone x86-64 UEFI GRUB bootloader to ESP...", flush=True)
        (target / "boot" / "grub").mkdir(parents=True, exist_ok=True)
        (target / "boot" / "efi" / "EFI" / "BOOT").mkdir(parents=True, exist_ok=True)
        (target / "etc" / "os1").mkdir(parents=True, exist_ok=True)
        (target / "etc" / "os1" / "root-partuuid").write_text(f"{root_partuuid}\n", encoding="utf-8")

        if args.encrypt:
            (target / "etc" / "os1" / "luks-uuid").write_text(f"{luks_uuid}\n", encoding="utf-8")
            (target / "etc" / "os1" / "boot-label").write_text("OS1_BOOT\n", encoding="utf-8")
            print("[os1-install] Building LUKS2 unlock initramfs (/boot/initrd.img-os1-luks)...", flush=True)
            luks_builder = target / "usr" / "sbin" / "os1-build-luks-initramfs"
            if not luks_builder.is_file():
                raise RuntimeError("LUKS2 initramfs builder missing: /usr/sbin/os1-build-luks-initramfs")
            run_checked(
                [
                    "chroot",
                    str(target),
                    "/usr/sbin/os1-build-luks-initramfs",
                    "--luks-uuid",
                    luks_uuid,
                    "--mapper",
                    luks_mapper,
                    "--output",
                    "/boot/initrd.img-os1-luks",
                ],
                env=chroot_env,
            )

        # Remove any legacy unversioned /boot/vmlinuz-os1 so os1-update-boot only tracks versioned kernels
        legacy_vmlinuz = target / "boot" / "vmlinuz-os1"
        if legacy_vmlinuz.exists():
            legacy_vmlinuz.unlink()

        if (target / "usr" / "sbin" / "os1-update-boot").is_file():
            run_checked(["chroot", str(target), "/usr/sbin/os1-update-boot"], env=chroot_env)
        else:
            grub_cfg = f"""insmod part_gpt
insmod fat
insmod ext2
search --no-floppy --set=root --label OS1_ROOT

serial --unit=0 --speed=115200
terminal_input console serial
terminal_output console serial

set default=0
set timeout=3

menuentry "OS-1 ({kernel_rel})" {{
    linux /boot/{vmlinuz_versioned} root=PARTUUID={root_partuuid} rw console=tty0 console=ttyS0,115200n8 net.ifnames=0 apparmor=1 security=apparmor panic=-1
}}

menuentry "OS-1 Recovery ({kernel_rel})" {{
    linux /boot/{vmlinuz_versioned} root=PARTUUID={root_partuuid} rw console=tty0 console=ttyS0,115200n8 net.ifnames=0 systemd.unit=rescue.target panic=-1
}}
"""
            (target / "boot" / "grub" / "grub.cfg").write_text(grub_cfg, encoding="utf-8")

        # Embed a minimal bootstrap stub in BOOTX64.EFI that dynamically loads grub.cfg
        # so kernel package upgrades & rollbacks take effect atomically without touching ESP.
        stub_cfg = target / "boot" / "grub" / "efi-bootstrap.cfg"
        if args.encrypt:
            stub_cfg.write_text(
                "insmod part_gpt\n"
                "insmod fat\n"
                "insmod ext2\n"
                "search --no-floppy --set=root --label OS1_BOOT\n"
                "if [ -f /grub/grub.cfg ]; then\n"
                "    configfile /grub/grub.cfg\n"
                "fi\n"
                f"linux /{vmlinuz_versioned} root=/dev/mapper/{luks_mapper} cryptdevice=UUID={luks_uuid}:{luks_mapper} rw console=tty0 console=ttyS0,115200n8 net.ifnames=0 apparmor=1 security=apparmor panic=-1\n"
                "initrd /initrd.img-os1-luks\n"
                "boot\n",
                encoding="utf-8",
            )
        else:
            stub_cfg.write_text(
                "insmod part_gpt\n"
                "insmod fat\n"
                "insmod ext2\n"
                "search --no-floppy --set=root --label OS1_ROOT\n"
                "if [ -f /boot/grub/grub.cfg ]; then\n"
                "    configfile /boot/grub/grub.cfg\n"
                "fi\n"
                f"search --no-floppy --set=root --file /EFI/os1/{vmlinuz_versioned}\n"
                f"linux /EFI/os1/{vmlinuz_versioned} root=PARTUUID={root_partuuid} rw console=tty0 console=ttyS0,115200n8 net.ifnames=0 apparmor=1 security=apparmor panic=-1\n"
                "boot\n",
                encoding="utf-8",
            )

        run_checked(
            [
                "chroot",
                str(target),
                "grub-mkstandalone",
                "--format=x86_64-efi",
                "--output=/boot/efi/EFI/BOOT/BOOTX64.EFI",
                "--locales=",
                "--fonts=",
                "boot/grub/grub.cfg=/boot/grub/efi-bootstrap.cfg",
            ],
            env=chroot_env,
        )
        shutil.copyfile(
            target / "boot" / "efi" / "EFI" / "BOOT" / "BOOTX64.EFI",
            efi_os1_dir / "grubx64.efi",
        )

        # === STAGE 12: Post-install validation ===
        print("[os1-install] Running post-install validation...", flush=True)
        required_paths = [
            target / "boot" / "efi" / "EFI" / "BOOT" / "BOOTX64.EFI",
            target / "boot" / "efi" / "EFI" / "os1" / vmlinuz_versioned,
            target / "boot" / vmlinuz_versioned,
            target / "etc" / "fstab",
            target / "etc" / "os-release",
            target / "etc" / "machine-id",
            target / "home" / args.user,
        ]
        if args.encrypt:
            required_paths.extend([
                target / "boot" / "initrd.img-os1-luks",
                target / "etc" / "crypttab",
                target / "etc" / "os1" / "luks-uuid",
            ])
        for required_path in required_paths:
            if not required_path.exists():
                raise RuntimeError(f"Post-install validation failed: missing {required_path}")

        if (target / "etc" / "os1-live-mode").exists():
            raise RuntimeError("Post-install validation failed: /etc/os1-live-mode still present")
        if sddm_conf.is_file() and "[Autologin]" in sddm_conf.read_text(encoding="utf-8"):
            raise RuntimeError("Post-install validation failed: live SDDM [Autologin] still present")
        if not (target / "etc" / "machine-id").read_text(encoding="utf-8").strip():
            raise RuntimeError("Post-install validation failed: /etc/machine-id is empty")

        uid_out = subprocess.check_output(["chroot", str(target), "id", "-u", args.user], text=True, env=chroot_env).strip()
        if int(uid_out) <= 0:
            raise RuntimeError(f"Post-install validation failed: invalid UID {uid_out} for {args.user}")

        # === STAGE 13: Cleanup and final report ===
        run_checked(["sync"])
        cleanup_mounts()

        print("=== OS-1_INSTALL_COMPLETE ===")
        enc_msg = f", LUKS_UUID={luks_uuid}" if args.encrypt else ""
        print(f"[os1-install] Installed OS-1 to {args.disk} (ROOT_UUID={root_uuid}, EFI_UUID={efi_uuid}{enc_msg}).")
        print("[os1-install] Remove the installation media and reboot.", flush=True)
        return 0
    finally:
        cleanup_mounts()


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
