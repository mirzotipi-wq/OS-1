#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-only
# Phase 10: OS-1 First-Run Onboarding & System Preferences Helper.
set -euo pipefail

STATE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/os1-onboarding.conf"
APPEARANCE=""
REDUCED_MOTION=""
REDUCED_TRANSPARENCY=""
MODE="status"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --status)
            MODE="status"
            shift
            ;;
        --apply)
            MODE="apply"
            shift
            ;;
        --appearance)
            APPEARANCE="$2"
            shift 2
            ;;
        --reduced-motion)
            REDUCED_MOTION="$2"
            shift 2
            ;;
        --reduced-transparency)
            REDUCED_TRANSPARENCY="$2"
            shift 2
            ;;
        -h|--help)
            cat <<EOF
OS-1 First-Run Onboarding Helper

Usage:
  os1-firstboot --status
  os1-firstboot --apply [--appearance light|dark] [--reduced-motion on|off] [--reduced-transparency on|off]
EOF
            exit 0
            ;;
        *)
            echo "Unknown option: $1" >&2
            exit 2
            ;;
    esac
done

if [[ "${MODE}" == "status" ]]; then
    echo "=== OS-1 Onboarding Status ==="
    if [[ -f "${STATE_FILE}" ]]; then
        cat "${STATE_FILE}"
    else
        echo "completed=false"
    fi
    exit 0
fi

mkdir -p "$(dirname "${STATE_FILE}")"
if [[ -n "${APPEARANCE}" ]]; then
    os1-appearance "${APPEARANCE}"
fi
if [[ -n "${REDUCED_MOTION}" ]]; then
    os1-accessibility reduced-motion "${REDUCED_MOTION}"
fi
if [[ -n "${REDUCED_TRANSPARENCY}" ]]; then
    os1-accessibility reduced-transparency "${REDUCED_TRANSPARENCY}"
fi

cat > "${STATE_FILE}" <<EOF
completed=true
appearance=${APPEARANCE:-light}
reduced_motion=${REDUCED_MOTION:-off}
reduced_transparency=${REDUCED_TRANSPARENCY:-off}
EOF
echo "[os1-firstboot] Onboarding preferences saved to ${STATE_FILE}"
