#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-only
# OS-1 deterministic compressed RAM swap (zram) setup helper.
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

ACTION="${1:-start}"

case "${ACTION}" in
    start)
        if grep -q '/dev/zram0' /proc/swaps 2>/dev/null; then
            echo "[os1-zram] /dev/zram0 is already active."
            exit 0
        fi
        if [[ ! -b /dev/zram0 ]]; then
            modprobe zram num_devices=1 2>/dev/null || true
        fi
        if [[ ! -b /dev/zram0 || ! -d /sys/block/zram0 ]]; then
            echo "[os1-zram] WARN: /dev/zram0 not available in kernel; skipping zram swap." >&2
            exit 0
        fi

        mem_kb="$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)"
        # 50% of RAM, clamped between 256 MiB and 4096 MiB
        zram_mb=$(( mem_kb / 2048 ))
        if (( zram_mb < 256 )); then
            zram_mb=256
        elif (( zram_mb > 4096 )); then
            zram_mb=4096
        fi
        zram_bytes=$(( zram_mb * 1024 * 1024 ))

        # Reset device cleanly before configuring
        echo 1 > /sys/block/zram0/reset 2>/dev/null || true

        # Prefer zstd > lz4 > lzo-rle only if supported by the running kernel; otherwise keep kernel default
        chosen_algo="default"
        if [[ -w /sys/block/zram0/comp_algorithm ]]; then
            avail="$(cat /sys/block/zram0/comp_algorithm 2>/dev/null || true)"
            for cand in zstd lz4 lzo-rle lzo; do
                if echo "${avail}" | grep -qw "${cand}"; then
                    if echo "${cand}" > /sys/block/zram0/comp_algorithm 2>/dev/null; then
                        chosen_algo="${cand}"
                        break
                    fi
                fi
            done
        fi

        echo "${zram_bytes}" > /sys/block/zram0/disksize
        mkswap -L OS1_ZRAM /dev/zram0 >/dev/null
        swapon -p 100 /dev/zram0
        echo "[os1-zram] Activated /dev/zram0 (${zram_mb} MiB, algo=${chosen_algo}, priority=100)"
        ;;
    stop)
        if grep -q '/dev/zram0' /proc/swaps 2>/dev/null; then
            swapoff /dev/zram0
        fi
        echo 1 > /sys/block/zram0/reset 2>/dev/null || true
        ;;
    *)
        echo "Usage: $0 {start|stop}" >&2
        exit 2
        ;;
esac
