#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-only
"""Phase 20 / Production: Atomic UEFI GRUB menu generator for versioned OS-1 kernels.

Scans /boot/vmlinuz-* (newest version first), preserves all installed kernels
for rollback, enables AppArmor LSM, supports both standard ext4 and LUKS2
encrypted root volumes, and atomically writes /boot/grub/grub.cfg via temp
file + fsync + os.replace.
"""

import argparse
import functools
import os
import re
import subprocess
import sys


def _dpkg_ver_cmp(a: str, b: str) -> int:
    if a == b:
        return 0
    r = subprocess.run(["dpkg", "--compare-versions", a, "gt", b])
    return 1 if r.returncode == 0 else -1


def discover_kernels(boot_dir: str) -> list[str]:
    rels: list[str] = []
    if not os.path.isdir(boot_dir):
        return rels
    for entry in os.listdir(boot_dir):
        if not entry.startswith("vmlinuz-"):
            continue
        full = os.path.join(boot_dir, entry)
        if os.path.islink(full) or not os.path.isfile(full):
            continue
        rel = entry[len("vmlinuz-"):]
        if rel:
            rels.append(rel)
    # Sort newest-first using dpkg version comparison
    rels.sort(key=functools.cmp_to_key(_dpkg_ver_cmp), reverse=True)
    return rels


def _find_initrd_rel(boot_dir: str, krel: str, boot_prefix: str) -> str | None:
    per_kernel = os.path.join(boot_dir, f"initrd.img-{krel}")
    if os.path.isfile(per_kernel):
        return f"{boot_prefix}/initrd.img-{krel}"
    luks_generic = os.path.join(boot_dir, "initrd.img-os1-luks")
    if os.path.isfile(luks_generic):
        return f"{boot_prefix}/initrd.img-os1-luks"
    return None


def render_grub_cfg(
    kernels: list[str],
    boot_dir: str,
    root_label: str = "OS1_ROOT",
    root_spec: str | None = None,
    timeout: int = 3,
    default_kernel: str | None = None,
    luks_uuid: str | None = None,
    boot_label: str | None = None,
) -> str:
    if default_kernel and default_kernel in kernels:
        ordered = [default_kernel] + [k for k in kernels if k != default_kernel]
    else:
        ordered = list(kernels)

    separate_boot = bool(boot_label)
    search_label = boot_label if separate_boot else root_label
    boot_prefix = "" if separate_boot else "/boot"

    if luks_uuid:
        root_cmdline = f"root=/dev/mapper/os1_crypt cryptdevice=UUID={luks_uuid}:os1_crypt"
    else:
        root_arg = root_spec or f"LABEL={root_label}"
        root_cmdline = f"root={root_arg}"

    sec_args = "apparmor=1 security=apparmor"

    lines = [
        "# Auto-generated by os1-update-boot — do not edit directly.",
        "insmod part_gpt",
        "insmod fat",
        "insmod ext2",
        f"search --no-floppy --set=root --label {search_label}",
        "",
        "serial --unit=0 --speed=115200",
        "terminal_input console serial",
        "terminal_output console serial",
        "",
        "set default=0",
        f"set timeout={timeout}",
        "",
    ]

    if not ordered:
        # Fallback if only legacy unversioned /boot/vmlinuz exists
        if os.path.isfile(os.path.join(boot_dir, "vmlinuz")):
            lines.extend([
                'menuentry "OS-1 (Installed System)" {',
                f"    linux {boot_prefix}/vmlinuz {root_cmdline} rw console=tty0 console=ttyS0,115200n8 net.ifnames=0 {sec_args} panic=-1",
                "}",
                "",
                'menuentry "OS-1 Recovery Mode" {',
                f"    linux {boot_prefix}/vmlinuz {root_cmdline} rw console=tty0 console=ttyS0,115200n8 net.ifnames=0 systemd.unit=rescue.target panic=-1",
                "}",
                "",
            ])
        return "\n".join(lines)

    # First list normal boot entries for every installed kernel (default=0 is newest,
    # entry 1 is the previous known-good kernel for 1-keypress Down+Enter rollback!)
    for idx, krel in enumerate(ordered):
        tag = " (default)" if idx == 0 else " (previous/rollback)"
        initrd_path = _find_initrd_rel(boot_dir, krel, boot_prefix)
        lines.append(f'menuentry "OS-1 ({krel}){tag}" {{')
        lines.append(
            f"    linux {boot_prefix}/vmlinuz-{krel} {root_cmdline} rw console=tty0 console=ttyS0,115200n8 net.ifnames=0 {sec_args} panic=-1"
        )
        if initrd_path:
            lines.append(f"    initrd {initrd_path}")
        lines.append("}")
        lines.append("")

    # Then list recovery entries for every installed kernel
    for krel in ordered:
        initrd_path = _find_initrd_rel(boot_dir, krel, boot_prefix)
        lines.append(f'menuentry "OS-1 Recovery ({krel})" {{')
        lines.append(
            f"    linux {boot_prefix}/vmlinuz-{krel} {root_cmdline} rw console=tty0 console=ttyS0,115200n8 net.ifnames=0 systemd.unit=rescue.target panic=-1"
        )
        if initrd_path:
            lines.append(f"    initrd {initrd_path}")
        lines.append("}")
        lines.append("")

    return "\n".join(lines)


def atomic_write(path: str, content: str) -> None:
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp_path = f"{path}.tmp.{os.getpid()}"
    with open(tmp_path, "w", encoding="utf-8") as f:
        f.write(content)
        f.flush()
        os.fsync(f.fileno())
    os.chmod(tmp_path, 0o644)
    os.replace(tmp_path, path)


def main() -> int:
    parser = argparse.ArgumentParser(description="OS-1 atomic GRUB configuration updater")
    parser.add_argument("--root", default="/", help="Target system root directory (default: /)")
    parser.add_argument("--root-label", default="OS1_ROOT", help="Root filesystem label (default: OS1_ROOT)")
    parser.add_argument("--timeout", type=int, default=3, help="GRUB menu timeout seconds (default: 3)")
    parser.add_argument("--set-default", default=None, help="Pin a specific kernel release as default")
    args = parser.parse_args()

    boot_dir = os.path.join(args.root, "boot")
    grub_cfg = os.path.join(boot_dir, "grub", "grub.cfg")
    default_file = os.path.join(args.root, "etc", "os1", "default-kernel")
    partuuid_file = os.path.join(args.root, "etc", "os1", "root-partuuid")
    luks_file = os.path.join(args.root, "etc", "os1", "luks-uuid")
    boot_label_file = os.path.join(args.root, "etc", "os1", "boot-label")

    root_spec = None
    if os.path.isfile(partuuid_file):
        pu = open(partuuid_file, encoding="utf-8").read().strip()
        if pu:
            root_spec = f"PARTUUID={pu}"

    luks_uuid = None
    if os.path.isfile(luks_file):
        luks_uuid = open(luks_file, encoding="utf-8").read().strip() or None

    boot_label = None
    if os.path.isfile(boot_label_file):
        boot_label = open(boot_label_file, encoding="utf-8").read().strip() or None

    default_kernel = args.set_default
    if default_kernel:
        if not re.match(r"^[A-Za-z0-9._+-]+$", default_kernel):
            print(f"ERROR: Invalid kernel release name: {default_kernel}", file=sys.stderr)
            return 2
        atomic_write(default_file, default_kernel + "\n")
    elif os.path.isfile(default_file):
        default_kernel = open(default_file, encoding="utf-8").read().strip() or None

    kernels = discover_kernels(boot_dir)
    if default_kernel and default_kernel not in kernels:
        default_kernel = None

    cfg = render_grub_cfg(
        kernels=kernels,
        boot_dir=boot_dir,
        root_label=args.root_label,
        root_spec=root_spec,
        timeout=args.timeout,
        default_kernel=default_kernel,
        luks_uuid=luks_uuid,
        boot_label=boot_label,
    )
    atomic_write(grub_cfg, cfg)
    enc_note = f", LUKS2={luks_uuid}" if luks_uuid else ""
    print(f"[os1-update-boot] Updated {grub_cfg} ({len(kernels)} versioned kernel(s): {kernels}{enc_note})")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
